<% layout("layouts/boilerplate") %>

    <div class="row mt-3">
        <h1 class="col-6 offset-3">Login</h1>
        <div class="col-8 offset-2">
            <form action="/login" method="post" class="needs-validation" novalidate>
                <div class="mb-3">

                    <label for="username" class="form-label">UserName</label>
                    <input name=username type="text" class="form-control" type="text" id="username">
                    <div class="valid-feedback"> looks good</div>
                </div>

              


                <div class="mb-3">

                    <label for="password" class="form-label">Password</label>
                    <input name=password type="password" class="form-control" type="text" id="password" required>
                    <div class="valid-feedback"> looks good</div>
                </div>


<button class="btn btn-success"> Login
</button>
            </form>


        </div>
    </div>